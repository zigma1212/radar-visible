# radar/.env.example
# Copia este archivo a un archivo de entorno local y completa lo que necesites.
# Todo es opcional: sin claves, el Radar funciona en modo plantilla.

# Proveedor de IA: anthropic | openai | plantilla (vacío = automático según la clave que exista)
IA_PROVEEDOR=

# Anthropic (Claude). Modelo por defecto: claude-sonnet-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI (alternativa). Modelo por defecto: gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# Entrega del brief a Slack (webhook entrante). Vacío = vista previa en pantalla.
SLACK_WEBHOOK_URL=
# Menciones en el brief: nombre del dueño = ID de miembro de Slack (perfil → ⋮ → Copiar ID de miembro). Separar con comas.
# Ejemplo: SLACK_MENCIONES=Pedro=U0123ABC,Valentina Correa=U0456DEF
SLACK_MENCIONES=

# Fecha de corte de la demo (YYYY-MM-DD). Vacío = 2026-10-05
DEMO_TODAY=

# radar/.env.example · Acceso con usuario y clave (solo para la demo publicada). Vacías = sin clave.
DEMO_USUARIO=
DEMO_CLAVE=
